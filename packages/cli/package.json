{
  "name": "@anchormem/cli",
  "version": "0.0.1",
  "description": "Anchor CLI — manage your local memory store.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "anchor": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anchormem/server": "*",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "files": ["dist", "README.md"]
}
