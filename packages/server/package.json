{
  "name": "@anchormem/server",
  "version": "0.1.3",
  "description": "Anchor MCP server — local-first cross-agent memory for AI coding agents.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "anchor",
    "memory",
    "ai",
    "claude",
    "codex",
    "cursor",
    "agents",
    "local-first"
  ],
  "homepage": "https://github.com/priyank766/anchor#readme",
  "bugs": {
    "url": "https://github.com/priyank766/anchor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyank766/anchor.git",
    "directory": "packages/server"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "anchor-server": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./scope": {
      "types": "./dist/scope.d.ts",
      "default": "./dist/scope.js"
    },
    "./capture/redact": {
      "types": "./dist/capture/redact.d.ts",
      "default": "./dist/capture/redact.js"
    },
    "./retrieval/compress": {
      "types": "./dist/retrieval/compress.d.ts",
      "default": "./dist/retrieval/compress.js"
    },
    "./store/db": {
      "types": "./dist/store/db.d.ts",
      "default": "./dist/store/db.js"
    },
    "./tools/list": {
      "types": "./dist/tools/list.d.ts",
      "default": "./dist/tools/list.js"
    },
    "./tools/recall": {
      "types": "./dist/tools/recall.d.ts",
      "default": "./dist/tools/recall.js"
    },
    "./tools/remember": {
      "types": "./dist/tools/remember.d.ts",
      "default": "./dist/tools/remember.js"
    },
    "./tools/forget": {
      "types": "./dist/tools/forget.d.ts",
      "default": "./dist/tools/forget.js"
    },
    "./tools/supersede": {
      "types": "./dist/tools/supersede.d.ts",
      "default": "./dist/tools/supersede.js"
    },
    "./providers/types": {
      "types": "./dist/providers/types.d.ts",
      "default": "./dist/providers/types.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "files": ["dist", "README.md"]
}
